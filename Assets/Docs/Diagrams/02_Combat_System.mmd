    CS -- "4. Đọc Defense gốc" --> CD
    CM -- "5. Gọi hàm trừ máu" --> CS
    CS -- "6. Kích hoạt" --> HE
    CS -- "7. Kích hoạt" --> ESM
    CS -- "8. Gửi sự kiện OnDied" --> CM
    CM -- "9. Báo tử cho Hệ thống" --> GameState
